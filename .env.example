ENVIRONMENT=production
ALLOW_MOCK_AUTH=false
MOCK_AI=false
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5.2
FIREBASE_CREDENTIALS_PATH=C:/Users/serkan/secure/firebase-service-account.json
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=18
REVENUECAT_WEBHOOK_SECRET=change-this-secret

# Google Play Billing server-side verification
GOOGLE_PLAY_PACKAGE_NAME=com.sirrafal.app
# Paste the full service-account JSON as one line in Render env. Do not commit a real key.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
