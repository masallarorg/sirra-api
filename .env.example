APP_NAME=Sırra API
ENVIRONMENT=production
MOCK_AI=false
ALLOW_MOCK_AUTH=false

# OpenAI Responses API. Keep this only on the backend/server.
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2600
OPENAI_REQUEST_TIMEOUT_SECONDS=70
OPENAI_RETRIES=2

# Natural Turkish fortune narration
# Firebase Admin / Auth
# Comma-separated emails allowed to open the mobile admin panel.
ADMIN_EMAILS=owner@example.com
FIREBASE_CREDENTIALS_PATH=/secure/firebase-service-account.json

# Use explicit origins in production, for example: https://sirrafal.app,https://admin.sirrafal.app
CORS_ORIGINS=https://your-public-site.example
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=api.your-domain.example
RATE_LIMIT_PER_MINUTE=18

# Image upload limits before OpenAI vision calls
MAX_IMAGE_UPLOAD_MB=8
MAX_OPENAI_IMAGE_EDGE_PX=1280

# Revenue / Google Play
REVENUECAT_WEBHOOK_SECRET=change-this-secret
GOOGLE_PLAY_PACKAGE_NAME=com.sirrafal.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=

# AdMob rewarded Server-Side Verification (SSV)
# Use the full production rewarded ad unit id shown in AdMob.
ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-7479381661494073/9143635106
ADMOB_REWARD_AMOUNT=2
ADMOB_SSV_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
ADMOB_SSV_MAX_AGE_SECONDS=86400

GOOGLE_TTS_ENABLED=false
GOOGLE_TTS_LANGUAGE_CODE=tr-TR
GOOGLE_TTS_VOICE_NAME=tr-TR-Chirp3-HD-Aoede
SPEECH_FALLBACK_ENABLED=true
SPEECH_MODEL=gpt-4o-mini-tts
SPEECH_VOICE=marin
